{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/dev-dist",
			"!**/.wrangler",
			"!**/worker-configuration.d.ts",
			"!.cursor",
			"!.github"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": {
					"level": "error",
					"options": { "allow": ["error", "warn"] }
				}
			}
		}
	},
	"plugins": ["./biome-plugins/no-type-assertion.grit"],
	"overrides": [
		{
			"includes": ["worker/scripts/**"],
			"linter": {
				"rules": {
					"suspicious": { "noConsole": "off" }
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
