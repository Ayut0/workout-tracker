{
	"name": "workout-tracker",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"deploy:app": "pnpm build && pnpm --filter worker exec wrangler pages deploy ../dist --project-name workout-tracker",
		"deploy:push": "pnpm --filter worker deploy"
	},
	"dependencies": {
		"dexie": "^4.4.7",
		"dexie-react-hooks": "^4.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"workbox-precaching": "^7.4.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"fake-indexeddb": "^6.2.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
