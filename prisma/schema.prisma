// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Ignore this warning because this schema is correct for Prisma 6
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique
  name      String?
  createdAt DateTime @default(now())

  workouts  Workout[]
  exercises Exercise[]

  @@map("user_profiles")
}

model Exercise {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  ownerId      String?       @db.Uuid
  owner        UserProfile?  @relation(fields: [ownerId], references: [id])
  isGlobal     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  workoutItems WorkoutItem[]

  @@unique([ownerId, name])
  @@map("exercises")
}

model Workout {
  id     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String        @db.Uuid
  date   DateTime      @default(now())
  notes  String?
  items  WorkoutItem[]
  user   UserProfile   @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@map("workouts")
}

model WorkoutItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workoutId  String   @db.Uuid
  exerciseId String   @db.Uuid
  order      Int
  sets       Set[]
  workout    Workout  @relation(fields: [workoutId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@index([workoutId])
  @@map("workout_items")
}

model Set {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workoutItemId String      @db.Uuid
  setIndex      Int
  reps          Int
  weight        Decimal     @db.Decimal(7, 3)
  workoutItem   WorkoutItem @relation(fields: [workoutItemId], references: [id])

  @@unique([workoutItemId, setIndex])
  @@map("sets")
}
